<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Evergine Tools Demo</ApplicationTitle>
    <ApplicationId>ai.ansight.testapps.everginetools</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <AnsightRemoteToolsPolicy Condition="'$(Configuration)' == 'Debug'">Allowed</AnsightRemoteToolsPolicy>
    <EvergineProfileName Condition="'$(TargetFramework)' == 'net10.0-ios'">#MAUI#iOS</EvergineProfileName>
    <EvergineProfileName Condition="'$(TargetFramework)' == 'net10.0-android'">#MAUI#Android</EvergineProfileName>
    <EvergineProjectFilePath>$(MSBuildProjectDirectory)/EvergineToolsDemo.weproj</EvergineProjectFilePath>
    <EvergineAssetContent>$(MSBuildProjectDirectory)/Content</EvergineAssetContent>
  </PropertyGroup>

  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#14213d" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <PackageReference Include="Evergine.Common" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Components" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Framework" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Mathematics" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Runtimes.GLB" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Targets" Version="2025.10.21.3204" />
    <MauiAsset Include="Assets/AirJordan.glb" LogicalName="AirJordan.glb" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="Evergine.Android" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Vulkan" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Targets.Maui" Version="2025.10.21.3204" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <PackageReference Include="Evergine.iOS" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.HLSLEverywhere" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Metal" Version="2025.10.21.3204" />
    <PackageReference Include="Evergine.Targets.iOS" Version="2025.10.21.3204" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Ansight.Maui" Version="1.6.1" />
  </ItemGroup>
</Project>
