<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ansight.ScreenshotGeometryHarness</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Installable through ADB/Ansight without IDE fast-deployment files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Screenshot Geometry</ApplicationTitle>
    <ApplicationId>ai.ansight.testapps.screenshotgeometry</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <AnsightRemoteToolsPolicy Condition="'$(Configuration)' == 'Debug'">Allowed</AnsightRemoteToolsPolicy>
    <AnsightRemoteToolsPolicy Condition="'$(Configuration)' != 'Debug'">Disallowed</AnsightRemoteToolsPolicy>
    <IncludeSystemUiMetadata Condition="'$(IncludeSystemUiMetadata)' == ''">true</IncludeSystemUiMetadata>
    <!-- Prefer the sibling source checkout until screenshot system-UI metadata ships. -->
    <AnsightSdkRoot Condition="'$(AnsightSdkRoot)' == '' and '$(AnsightPackageVersion)' == '' and Exists('$(MSBuildThisFileDirectory)../../../ansight/ansight-sdk/src/dotnet/Ansight.Maui/Ansight.Maui.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../ansight/ansight-sdk'))</AnsightSdkRoot>
    <AnsightSdkRoot Condition="'$(AnsightSdkRoot)' == '' and '$(AnsightPackageVersion)' == '' and Exists('$(MSBuildThisFileDirectory)../../../ansight-sdk/src/dotnet/Ansight.Maui/Ansight.Maui.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../ansight-sdk'))</AnsightSdkRoot>
    <AnsightHostDiscoveryPort Condition="'$(AnsightHostDiscoveryPort)' == ''">45123</AnsightHostDiscoveryPort>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
    <CodesignProvision></CodesignProvision>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#293354" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#293354" BaseSize="128,128" />
    <AssemblyMetadata Include="IncludeSystemUiMetadata" Value="$(IncludeSystemUiMetadata)" />
    <AssemblyMetadata Include="AnsightHostDiscoveryPort" Value="$(AnsightHostDiscoveryPort)" />
  </ItemGroup>
  <ItemGroup Condition="'$(AnsightSdkRoot)' == ''">
    <PackageReference Include="Ansight.Maui" Version="$(AnsightPackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(AnsightSdkRoot)' != ''">
    <ProjectReference Include="$(AnsightSdkRoot)/src/dotnet/Ansight.Maui/Ansight.Maui.csproj" />
  </ItemGroup>
  <!-- Project references do not import the NuGet package's buildTransitive policy. -->
  <Import Project="$(AnsightSdkRoot)/src/dotnet/Ansight.Core/build/Ansight.targets" Condition="'$(AnsightSdkRoot)' != ''" />
  <Target Name="RequirePublicationSdk" BeforeTargets="CollectPackageReferences" Condition="'$(AnsightSdkRoot)' == '' and '$(AnsightPackageVersion)' == ''">
    <Error Text="Set AnsightSdkRoot to the SDK checkout with screenshot system-UI metadata, or AnsightPackageVersion to a release containing it." />
  </Target>
</Project>
