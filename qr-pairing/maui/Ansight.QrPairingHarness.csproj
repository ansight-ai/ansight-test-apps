<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Ansight.QrPairingHarness</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Ansight QR Pairing</ApplicationTitle>
    <ApplicationId>ai.ansight.testapps.qrpairing</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <AnsightRemoteToolsPolicy Condition="'$(Configuration)' == 'Debug'">Allowed</AnsightRemoteToolsPolicy>
    <AnsightRemoteToolsPolicy Condition="'$(Configuration)' != 'Debug'">Disallowed</AnsightRemoteToolsPolicy>
    <AnsightUnattendedProvisioningEnabled Condition="'$(AnsightUnattendedProvisioningEnabled)' == ''">false</AnsightUnattendedProvisioningEnabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(AnsightUnattendedProvisioningEnabled)' == 'true'">
    <DefineConstants>$(DefineConstants);ANSIGHT_UNATTENDED_PROVISIONING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator'))">
    <EnableCodeSigning>true</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
    <CodesignProvision></CodesignProvision>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#153D4D" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#153D4D" BaseSize="128,128" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Ansight.Maui" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Ansight/**/*.cs" />
  </ItemGroup>
</Project>
