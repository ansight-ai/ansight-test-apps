<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Pencil / MAUI Lab</ApplicationTitle>
    <ApplicationId>ai.ansight.testapps.pencil.maui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>17.5</SupportedOSPlatformVersion>
    <AnsightRemoteToolsPolicy>Allowed</AnsightRemoteToolsPolicy>
    <MauiVersion>9.0.120</MauiVersion>
    <AnsightPackageVersion Condition="'$(AnsightPackageVersion)' == ''">1.8.1</AnsightPackageVersion>
  </PropertyGroup>
  <!-- Package references intentionally exercise the precompiled native framework, not SDK source compilation. -->
  <ItemGroup>
    <PackageReference Include="Ansight.Maui" Version="$(AnsightPackageVersion)" />
    <PackageReference Include="Ansight.Pencil" Version="$(AnsightPackageVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>
