<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Boulder Capture Spike</ApplicationTitle>
    <ApplicationId>ai.ansight.testapps.realitykitcapture</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>Apple Development: Matthew Robbins (W9DY2VGJYM)</CodesignKey>
    <CodesignTeamId>65MZ7WPY52</CodesignTeamId>
    <CodesignProvision>Automatic</CodesignProvision>
    <EnableAnsightGpuCapture Condition="'$(EnableAnsightGpuCapture)' == ''">true</EnableAnsightGpuCapture>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableAnsightGpuCapture)' == 'true'">
    <DefineConstants>$(DefineConstants);BOULDER_ANSIGHT_GPU_CAPTURE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#101820" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
    <NativeReference Include="Native/build/iphoneos/libBoulderCaptureBridge.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <SmartLink>false</SmartLink>
      <Frameworks>RealityKit SwiftUI UIKit ARKit</Frameworks>
      <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
    </NativeReference>
    <ReferenceNativeSymbol Include="BoulderCapture_IsSupported" SymbolType="Function" />
    <ReferenceNativeSymbol Include="BoulderCapture_Present" SymbolType="Function" />
    <ReferenceNativeSymbol Include="SceneMesh_PresentWithQuality" SymbolType="Function" />
    <ReferenceNativeSymbol Include="SceneMesh_PresentGlb" SymbolType="Function" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Ansight.Maui" Version="1.6.2" />
  </ItemGroup>

  <Target Name="BuildBoulderCaptureBridge" BeforeTargets="ResolveNativeReferences" Inputs="Native/BoulderCaptureBridge.swift;Native/SceneMeshCapture.swift;Native/GlbPreview.swift;Native/DepthSpaceCapture.swift;Native/ObjToGlb.swift;Native/build-ios.sh" Outputs="Native/build/iphoneos/libBoulderCaptureBridge.a">
    <Exec Command="bash Native/build-ios.sh" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
